{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramp-protocol.org/schemas/comp/v1/comp-v1.schema.json",
  "title": "CoMP V1 \u2014 Content Monetization Protocols (supply + request)",
  "description": "JSON Schema (Draft 2020-12) for canonical CoMP V1, derived from IABTechLab/CoMP@main CoMP-1.0.md (commit 08c0181a). CoMP V1 ships as a Markdown spec with no upstream machine-readable schema; this fills that gap. A CoMP document carries a request-side aisystem and/or a supply-side package. Every canonical object forbids unknown keys (additionalProperties:false); non-CoMP extensions live under a nested open ext object.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "properties": {
    "aisystem": {
      "$ref": "#/$defs/AISystem"
    },
    "package": {
      "$ref": "#/$defs/Package"
    },
    "ext": {
      "type": "object",
      "description": "Open extension object; non-CoMP (e.g. RAMP) keys live here."
    }
  },
  "$defs": {
    "AISystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "aisysuse"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "ua": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "aisysuse": {
          "$ref": "#/$defs/AISystemUse"
        },
        "ext": {
          "type": "object",
          "description": "Open extension object; non-CoMP (e.g. RAMP) keys live here."
        }
      }
    },
    "AISystemUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lid",
        "aiauth"
      ],
      "properties": {
        "lid": {
          "type": "string"
        },
        "aiauth": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5
          ]
        },
        "uri": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "function": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          }
        },
        "subfn": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          }
        },
        "resdis": {
          "type": "integer"
        },
        "ext": {
          "type": "object",
          "description": "Open extension object; non-CoMP (e.g. RAMP) keys live here."
        }
      }
    },
    "Package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "seller": {
          "type": "string"
        },
        "packager": {
          "type": "string"
        },
        "licenseurl": {
          "type": "string"
