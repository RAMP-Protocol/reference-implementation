            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          }
        },
        "text": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "video": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Video"
          }
        },
        "image": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Image"
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Audio"
          }
        },
        "ext": {
          "type": "object",
          "description": "Open extension object; non-CoMP (e.g. RAMP) keys live here."
