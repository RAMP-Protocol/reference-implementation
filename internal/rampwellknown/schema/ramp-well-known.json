{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramp-protocol.org/schemas/ramp-well-known.json",
  "title": "RAMP WellKnownManifest",
  "description": "Canonical /.well-known/ramp.json commercial overlay. Wire shape is protojson of ramp.v1.WellKnownManifest with UseProtoNames=true (snake_case fields, full enum value names). Identity keys are NOT here — they live in the WBA directory (/.well-known/http-message-signatures-directory) and are referenced by RFC 7638 thumbprint.",
  "type": "object",
  "required": ["ver", "role", "domain"],
  "additionalProperties": true,
  "properties": {
    "ver": { "const": "1.0" },
    "role": {
      "enum": ["ROLE_AGENT", "ROLE_EXCHANGE", "ROLE_BROKER", "ROLE_PUBLISHER"]
    },
    "domain": { "type": "string", "minLength": 1 },
    "contact": { "type": "string" },
    "exchanges": {
      "type": "array",
      "items": { "$ref": "#/$defs/authorizedExchange" }
    },
    "catalog_contributors": {
      "type": "array",
      "items": { "$ref": "#/$defs/catalogContributor" }
    },
    "max_intermediary_hops": { "type": "integer", "minimum": 0 },
    "base_currency": { "type": "string" },
    "supported_profiles": { "type": "array", "items": { "type": "string" } },
    "terms_uri": { "type": "string" },
    "terms_digest": { "type": "string" },
    "account_registration": { "$ref": "#/$defs/accountRegistration" }
  },
  "$defs": {
    "accountRegistration": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "data_schema": { "type": "object" }
      }
    },
    "authorizedExchange": {
      "type": "object",
      "required": ["domain", "endpoint", "relationship"],
      "additionalProperties": true,
      "properties": {
        "domain": { "type": "string" },
        "endpoint": { "type": "string", "minLength": 1 },
        "relationship": {
          "enum": [
            "PROVIDER_RELATIONSHIP_UNSPECIFIED",
            "PROVIDER_RELATIONSHIP_DIRECT",
            "PROVIDER_RELATIONSHIP_RESELLER"
          ]
        }
      }
    },
    "catalogContributor": {
      "type": "object",
      "required": ["domain", "relationship"],
      "additionalProperties": true,
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "minLength": 1 }
      }
    }
  }
}
