# Copy to secrets.auto.tfvars (gitignored — the *.auto.tfvars pattern).
# Terraform loads *.auto.tfvars automatically; keeping the secrets in this
# separate file means terraform.tfvars stays safe to screen-share or paste.
# Alternative: skip the file and export TF_VAR_cloudflare_api_token /
# TF_VAR_registry_password instead.

cloudflare_api_token = "..."

# Only when the images are private (the VM's pull-only token):
# registry_password = "..."
