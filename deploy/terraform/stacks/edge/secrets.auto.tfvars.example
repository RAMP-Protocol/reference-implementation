# Copy to secrets.auto.tfvars (gitignored — the *.auto.tfvars pattern).
# Terraform loads *.auto.tfvars automatically; keeping the secret in this
# separate file means terraform.tfvars stays safe to screen-share or paste.
# Alternative: skip the file and export TF_VAR_cloudflare_api_token instead.

cloudflare_api_token = "..."
