{
  "name": "@ramp/edge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:cf": "wrangler deploy",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "cycles": "madge --circular --extensions ts src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:cf": "vitest run tests/e2e.cloudflare.test.ts",
    "test:e2e:aws": "vitest run --config vitest.aws.config.ts",
    "test:e2e:fastly": "vitest run --config vitest.fastly.config.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "serve:miniflare": "node scripts/serve-miniflare.mjs"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/vitest-pool-workers": "^0.5.30",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@fastly/js-compute": "^3.26.0",
    "@types/aws-lambda": "^8.10.145",
    "esbuild": "^0.24.2",
    "madge": "^8.0.0",
    "miniflare": "^3.20250109.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.101.0"
  }
}
