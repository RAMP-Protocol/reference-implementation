{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "ignore": ["dist", ".wrangler", "node_modules"]
  },
  "overrides": [
    {
      // console.info is allowed in the log module and nowhere else. The
      // worker's only telemetry channel is the console -- every runtime it
      // targets collects stdout and nothing else -- and info is the level a
      // successful licensed delivery belongs at: it is not a warning and not an
      // error. Scoping the allowance to this one file keeps a stray
      // console.info elsewhere in the worker an error, which is what the rule
      // is for. log and debug stay banned everywhere, so a debugging line
      // cannot reach production.
      "include": ["src/log.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": { "allow": ["warn", "error", "info"] }
            }
          }
        }
      }
    },
    {
      "include": ["tests/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "include": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noForEach": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessStringConcat": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useShorthandAssign": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": { "allow": ["warn", "error"] }
        }
      },
      "nursery": {
        "noSecrets": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
