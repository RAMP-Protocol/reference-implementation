# Miniflare-hosted Cloudflare Workers runtime for local E2E / demo deployments.
# Builds the runtime-agnostic Hono app via the Cloudflare entry, then serves
# it with Miniflare on 0.0.0.0:8787.
#
# Build (from src/edge/):
#   docker build -f Dockerfile.miniflare -t ramp/edge-miniflare:dev .

FROM node:22-slim AS builder
# @ramp-protocol/sdk-l1 is a git dependency (git+https://…/protocol#<sha>),
# resolved off-commit like the Go/pip pins — `npm ci` clones it, so no sibling
# checkout is mirrored in and any shallow workdir works. The slim base ships no
# git binary; install it for the clone.
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY . .
RUN node scripts/build-worker.mjs --out dist/worker.mjs

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8787
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/dist ./dist

EXPOSE 8787
USER node
ENTRYPOINT ["node", "scripts/serve-miniflare.mjs"]
